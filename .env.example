# Copy this file to .env and adjust the values for your server, then run:
#   docker compose up -d --build

# Public URL the browser uses to reach the API. Baked into the frontend at build
# time, so it must be reachable from the user's browser (e.g. https://api.example.com).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8800

# Public origin of the frontend. Used by the API for CORS.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shared cookie name (must match between frontend and backend).
COOKIE_NAME=tiny-wins

# Runtime environment: prod enables JSON logs and secure-by-default cookies.
ENVIRONMENT=prod

# Set to false to allow cookies over plain HTTP (e.g. an IP address with no TLS).
COOKIE_SECURE=false

# PostgreSQL credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=squares
