# Copy this file to .env and adjust the values for your server, then run:
#   docker compose up -d --build
#
# DNS: point an A/AAAA record for DOMAIN at this server and open ports 80 and 443
# so Caddy can obtain a TLS certificate.

# Domain served by Caddy (frontend + /api reverse proxy).
DOMAIN=tinywins.frasier.dev

# Email address for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=

# The browser talks to the API on the same origin under /api, so the frontend can
# be built without knowing the domain. Leave this as-is unless you proxy elsewhere.
NEXT_PUBLIC_BACKEND_URL=/api

# Shared cookie name (must match between frontend and backend).
COOKIE_NAME=tiny-wins

# Runtime environment. prod enables JSON logs.
ENVIRONMENT=prod

# Secure cookies require HTTPS. Caddy terminates TLS, so keep this true.
COOKIE_SECURE=true

# PostgreSQL credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=squares
